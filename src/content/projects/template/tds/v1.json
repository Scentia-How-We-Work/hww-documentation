    {
      "number": "12",
      "title": "Audit",
      "blocks": [],
      "subsections": [
        {
          "number": "12.1",
          "title": "What is audited",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 At minimum:"
            },
            {
              "type": "list",
              "items": [
                "Sign-in success, failure and lockout; sign-out; session revocation",
                "Authorisation failures",
                "Every change made by an administrative or internal role",
                "Role, permission and access-list changes",
                "Data exports (who, what filter, row count)",
                "Financial or balance-affecting events",
                "Changes to configuration and integration settings"
              ]
            }
          ]
        },
        {
          "number": "12.2",
          "title": "Audit event schema",
          "blocks": [
            {
              "type": "table",
              "columns": ["Field", "Type", "Notes"],
              "rows": [
                ["id", "UUIDv7", "Time-ordered"],
                ["occurred_at", "timestamptz (UTC)", "—"],
                ["actor_type", "enum", "user, system, integration"],
                ["actor_id", "text", "Null for system"],
                ["actor_display", "text", "Snapshot of name and email at the time"],
                ["actor_role", "text", "Role used for the action"],
                ["organisation_id", "uuid", "Tenant; null for global actions"],
                ["action", "text", "verb.noun, e.g. booking.approved"],
                ["target_type / target_id", "text", "Record affected"],
                [
                  "changes",
                  "jsonb",
                  "Before/after of changed fields; personal information minimised"
                ],
                ["reason", "text", "Optional user-supplied reason"],
                ["channel", "enum", "web, email_link, job, webhook"],
                ["request_id", "text", "Correlates with logs and Sentry"],
                ["ip_prefix", "text", "Truncated IP (/24 or /48)"]
              ]
            }
          ]
        },
        {
          "number": "12.3",
          "title": "Immutability",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Append-only table. The app's database role has INSERT and SELECT only; UPDATE and DELETE are revoked, and a trigger rejects them. Each row stores a hash of the previous row (hash chain) so tampering is detectable *(proposed)*."
            }
          ]
        },
        {
          "number": "12.4",
          "title": "Retention and access",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 7 years, then de-identified. Reading the audit log is itself audited. Audit records are separate from application logs (section 13)."
            }
          ]
        }
      ]
    },
    {
      "number": "13",
      "title": "Logging, monitoring and alerting",
      "blocks": [],
      "subsections": [
        {
          "number": "13.1",
          "title": "Structured logs",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 JSON logs with: timestamp, level, message, request_id, trace_id, route, status, duration_ms, organisation_id, user_id (internal ID, never email), error."
            }
          ]
        },
        {
          "number": "13.2",
          "title": "What must never be logged",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Sign-in codes, magic-link or action tokens, session IDs, cookies, authorization headers, card or bank details, email bodies, full email addresses (mask as j***@domain), free-text reasons."
            }
          ]
        },
        {
          "number": "13.3",
          "title": "Sentry",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 sendDefaultPii false; a beforeSend hook that scrubs the fields in 13.2; releases tagged with the commit SHA; source maps uploaded in CI; environment tag set."
            }
          ]
        },
        {
          "number": "13.4",
          "title": "Log retention and shipping",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Workers Logs for live debugging. Logpush to AU object storage for 90 days (security events 1 year)."
            }
          ]
        },
        {
          "number": "13.5",
          "title": "Service levels and alerts",
          "blocks": [
            {
              "type": "table",
              "columns": ["Alert", "Condition", "Severity", "Channel", "Runbook"],
              "rows": [
                ["Error rate", "5xx > 2% for 5 min", "High", "✏️", ""],
                ["Latency", "p95 above NFR for 15 min", "Medium", "✏️", ""],
                ["DLQ", "Any message in a DLQ", "High", "✏️", ""],
                ["Job missed", "Scheduled job didn't complete", "Medium", "✏️", ""],
                ["Auth abuse", "Sign-in rate limit tripped above threshold", "Medium", "✏️", ""]
              ]
            }
          ]
        }
      ]
    },
