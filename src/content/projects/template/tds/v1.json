    {
      "number": "9",
      "title": "Identity and access",
      "blocks": [],
      "subsections": [
        {
          "number": "9.1",
          "title": "Authentication",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Better Auth email one-time code and magic link. Codes are single-use, short-lived (default 10 minutes), stored hashed, and rate-limited per email and per IP. No account enumeration: the response is the same whether or not an email is known."
            }
          ]
        },
        {
          "number": "9.2",
          "title": "Sessions",
          "blocks": [
            {
              "type": "table",
              "columns": ["Role", "Absolute lifetime", "Idle timeout", "Notes"],
              "rows": [["", "", "", ""]]
            },
            {
              "type": "text",
              "text": "🔒 Session cookies are Secure, HttpOnly, SameSite=Lax and host-only. Sessions are stored server-side and revocable. Role changes and removals take effect on the next request."
            }
          ]
        },
        {
          "number": "9.3",
          "title": "Authorisation (RBAC)",
          "blocks": [
            {
              "type": "callout",
              "tone": "guidance",
              "text": "Permission matrix: roles across, actions down. Checks happen server-side in src/server on every request; the UI hiding something is never the control."
            }
          ]
        },
        {
          "number": "9.4",
          "title": "Signed action links",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Links that act without sign-in (approve, unsubscribe) carry a single-purpose, single-use, expiring token bound to one record, stored hashed. A confirmation page needs a POST: a GET never changes state, so email link scanners can't trigger actions."
            }
          ]
        },
        {
          "number": "9.5",
          "title": "Privileged access",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Admin consoles (Cloudflare, GitHub, database platform, Stripe, Resend, Sentry, Salesforce) need MFA, named accounts and least privilege. Access is reviewed quarterly."
            }
          ]
        }
      ]
    },
    {
      "number": "10",
      "title": "Security",
      "blocks": [],
      "subsections": [
        {
          "number": "10.1",
          "title": "Threat model",
          "blocks": [
            {
              "type": "callout",
              "tone": "guidance",
              "text": "STRIDE for each container and trust boundary in 3.3. One row per credible threat."
            },
            {
              "type": "table",
              "columns": ["ID", "Component", "STRIDE", "Threat", "Mitigation", "Status"],
              "rows": [["", "", "", "", "", ""]]
            }
          ]
        },
        {
          "number": "10.2",
          "title": "Baseline controls",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Mandatory for every app:"
            },
            {
              "type": "list",
              "items": [
                "TLS everywhere; HSTS; TLS to the database.",
                "Strict Content Security Policy (nonce-based), X-Content-Type-Options, Referrer-Policy, frame-ancestors none.",
                "CSRF protection on all state-changing requests.",
                "Zod validation on every input; parameterised queries only; output encoding by React.",
                "Rate limiting on authentication, exports and any expensive endpoint.",
                "Dependency updates (Renovate or Dependabot), CodeQL and gitleaks in CI.",
                "Secrets in Worker secrets only; least-privilege API tokens.",
                "Encryption at rest by the platform; restricted data hashed or encrypted at application level.",
                "File uploads and CSV inputs: size limits, type checks, and CSV-injection escaping on export."
              ]
            }
          ]
        },
        {
          "number": "10.3",
          "title": "Payment card scope",
          "blocks": [
            {
              "type": "text",
              "text": "🔒 Card data is only ever entered on the payment provider's hosted page (Stripe Checkout), keeping the app at PCI DSS SAQ-A. The app stores only provider IDs and payment status."
            }
          ]
        },
        {
          "number": "10.4",
          "title": "Go-live security gates",
          "blocks": [
            {
              "type": "callout",
              "tone": "warning",
              "text": "All four gates apply to production-tier apps. Thresholds and process are **TBD**."
            },
            {
              "type": "checklist",
              "items": [
                {
                  "text": "Threat model reviewed and signed off before build starts",
                  "done": false
                },
                {
                  "text": "OWASP ASVS Level 2 self-assessment completed and attached",
                  "done": false
                },
                {
                  "text": "Dependency scanning and SAST in CI, blocking on high severity",
                  "done": false
                },
                {
                  "text": "External penetration test before first production release, then annually",
                  "done": false
                }
              ]
            }
          ]
        },
