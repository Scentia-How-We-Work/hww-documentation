{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "scentia": {
      "source": {
        "source": "github",
        "repo": "Scentia-How-We-Work/coding-standards"
      }
    }
  },
  "enabledPlugins": {
    "scentia@scentia": true,
    "superpowers@claude-plugins-official": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.dev.vars)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.dev.vars)",
      "Bash(gh pr merge *)"
    ]
  }
}
